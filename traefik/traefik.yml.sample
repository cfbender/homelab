log:
  level: INFO

accessLog:
  filePath: /var/log/access.log
  filters:
    statusCodes:
      - "400-499"

api: {}

# Serves /ping on the internal :8080 entrypoint for `traefik healthcheck --ping`.
ping: {}

providers:
  docker:
    exposedByDefault: false
  file:
    directory: /etc/traefik/conf
    watch: true

entryPoints:
  web:
    address: ":80"
    forwardedHeaders:
      insecure: false
      trustedIPs:
        - 172.16.0.0/16
    proxyProtocol:
      insecure: false
      trustedIPs:
        - 10.0.69.0/24
        - 172.16.0.0/16
    http:
      redirections:
        entrypoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"
    proxyProtocol:
      insecure: false
      trustedIPs:
        - 10.0.69.0/24
        - 172.16.0.0/16
    forwardedHeaders:
      insecure: false
      trustedIPs:
        - 10.0.69.0/24
        - 172.20.69.30/32 # cloudflared
        - 172.16.0.0/16
        - 172.16.0.0/16
        - 127.17.0.1/32

certificatesResolvers:
  prod:
    acme:
      dnsChallenge:
        provider: cloudflare
      storage: /etc/traefik/acme.json
      email: <ACME_EMAIL>
      caServer: "https://acme-v02.api.letsencrypt.org/directory"
  staging:
    acme:
      dnsChallenge:
        provider: cloudflare
      storage: /etc/traefik/acme.json
      email: <ACME_EMAIL>
      caServer: "https://acme-staging-v02.api.letsencrypt.org/directory"

serversTransport:
  insecureSkipVerify: true

pilot:
  token: <PILOT_TOKEN>
